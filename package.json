{
  "name": "watch-it-think",
  "version": "0.1.0",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs@7.6.6": false,
    "fsevents": true
  },
  "private": true,
  "type": "module",
  "description": "Watch a 5M parameter router, trained from random init, resolve a sentence into an intent.",
  "scripts": {
    "build": "tsc --noEmit && npm run check && vite build && npm run check:layout && npm run check:boot && npm run check:draw && npm run check:announce && npm run check:keyboard && npm run check:weight && npm run check:motion && npm run check:attention && npm run check:capture && npm run check:first-screen",
    "capture": "node tools/capture.mjs",
    "check": "npm run check:authorship && npm run check:install && npm run check:palette && npm run check:licences && npm run check:claims && npm run check:tools && npm run check:tokenizer && npm run check:meta && npm run check:input",
    "check:announce": "node tools/check-announce.mjs",
    "check:attention": "node tools/check-attention.mjs",
    "check:authorship": "node tools/check-authorship.mjs",
    "check:boot": "node tools/check-boot.mjs",
    "check:capture": "node tools/check-capture.mjs",
    "check:claims": "node tools/check-claims.mjs",
    "check:draw": "node tools/check-draw.mjs",
    "check:first-screen": "node tools/check-first-screen.mjs",
    "check:input": "tsx tools/check-input-bound.ts",
    "check:install": "node tools/check-install-scripts.mjs",
    "check:keyboard": "node tools/check-keyboard.mjs",
    "check:layout": "node tools/check-layout.mjs",
    "check:licences": "node tools/check-licences.mjs",
    "check:meta": "node tools/check-meta.mjs",
    "check:motion": "node tools/check-motion.mjs",
    "check:palette": "node tools/check-palette.mjs",
    "check:tokenizer": "tsx tools/check-tokenizer.ts",
    "check:tools": "node tools/check-tools.mjs",
    "check:weight": "node tools/check-weight.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "vendor:tokens": "node tools/vendor-house-tokens.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wait-on": "9.0.1"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  }
}

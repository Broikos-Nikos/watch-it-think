{
  "name": "watch-it-think",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watch a 5M parameter router, trained from random init, resolve a sentence into an intent.",
  "scripts": {
    "check:tokenizer": "tsx tools/check-tokenizer.ts",
    "check": "npm run check:tools && npm run check:tokenizer && npm run check:meta && npm run check:input",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build && npm run check:layout && npm run check:boot && npm run check:draw",
    "preview": "vite preview",
    "check:tools": "node tools/check-tools.mjs",
    "check:meta": "node tools/check-meta.mjs",
    "check:input": "tsx tools/check-input-bound.ts",
    "check:layout": "node tools/check-layout.mjs",
    "check:boot": "node tools/check-boot.mjs",
    "check:draw": "node tools/check-draw.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "wait-on": "9.0.1"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs": false
  }
}

{
  "name": "watch-it-think",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watch a 5M parameter router, trained from random init, resolve a sentence into an intent.",
  "scripts": {
    "check:tokenizer": "tsx tools/check-tokenizer.ts",
    "check": "npm run check:tokenizer",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && npm run check && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "protobufjs": false
  }
}
